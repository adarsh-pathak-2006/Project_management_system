# ================================================================
# TaskHub Backend — Environment Variables
# ================================================================
# Copy this file to .env for local development.
# Set these as Environment Variables in your Render service dashboard.
#
# Note: ALLOWED_HOSTS and CORS are set to wildcard (*) in settings.py
# so you do NOT need to configure them here.
# ================================================================

# Django secret key — generate a strong random value for production
# You can generate one at: https://djecrety.ir/
SECRET_KEY=generate_a_secure_random_secret_key_here

# Set to False in production
DEBUG=False

# PostgreSQL connection string (from Neon, Render DB, Supabase, etc.)
DATABASE_URL=postgres://dbuser:dbpass@dbhost:5432/dbname

# (Optional) Redis connection string for caching (e.g. from Upstash)
# If not set, the app falls back to an in-memory cache automatically
REDIS_URL=rediss://default:your_password@your_upstash_endpoint:port
